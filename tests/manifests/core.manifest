# A deliberately small, checked-in manifest format.  Paths are relative to
# this manifest; args are passed through the library CLI parser.

[case.core]
source_test = "local-core"
oracle = "findent 4.3.8~pre01; env -u FINDENT_FLAGS LC_ALL=C findent -ifree"
category = "structural"
support = "supported"
normalization = "none"
input = "../fixtures/core.f90"
stdout = "../expected/core.out"
stderr = ""
status = "0"
args = "-ifree"

[case.lexical]
source_test = "local-lexical"
oracle = "findent 4.3.8~pre01; env -u FINDENT_FLAGS LC_ALL=C findent -ifree"
category = "lexical-openmp"
support = "supported"
normalization = "none"
input = "../fixtures/lexical.f90"
stdout = "../expected/lexical.out"
stderr = ""
status = "0"
args = "-ifree"

[case.continued_literal]
source_test = "local-continued-literal"
