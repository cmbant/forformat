stdout = "../expected/submodule_spacing.out"
stderr = ""
status = "0"
args = "-ifree"
mode = "full"

[case.corpus_rewrap_literal_write]
source_test = "canonicalize_rewrap.rs::rewrap_settles_a_literal_split_before_choosing_write_breaks"
oracle = "CP2K reduced I1 regression; generated literal concatenation settles before WRITE break selection"
category = "full-rewrap-idempotence"
support = "supported"
normalization = "literal-split settlement"
input = "../fixtures/corpus_rewrap_literal_write.f90"
stdout = "../expected/corpus_rewrap_literal_write.out"
stderr = ""
status = "0"
args = "--rewrap --line-length=100 --indent=4 --start-indent=28 --indent-continuation=4 --align-paren=4"
mode = "full"

