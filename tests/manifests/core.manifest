category = "legacy-free-constructs"
support = "supported"
normalization = "none"
input = "../fixtures/legacy_free_matrix.f90"
stdout = "../expected/legacy_free_matrix.out"
stderr = ""
status = "0"
args = "-ifree"

[case.external_macro_define]
source_test = "compatibility.rs::external_macro_case_is_exact"
oracle = "-D SIZE applies SIZE to uses, not protected bytes"
category = "macro-case"
support = "supported"
normalization = "none"
input = "../fixtures/external_macro_define.f90"
stdout = "../fixtures/external_macro_define.out"
stderr = ""
status = "0"
args = "-D SIZE"
mode = "full"

[case.submodule_spacing]
