[case.fixed_rejected]
source_test = "manifest.rs::fixed_form_rejection_contract"
oracle = "fixed-form input is outside the Rust free-form contract"
category = "fixed-form-exclusion"
support = "excluded"
normalization = "none"
input = "../fixtures/core.f90"
stdout = ""
stderr = "forformat: unsupported: fixed-form input/output is not supported\n"
status = "2"
args = "-ifixed"

